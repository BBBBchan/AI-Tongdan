# Optional module overrides; repository .env is read automatically.
# The web process calls model services; it does not load GPU models itself.
# Leave blank to reuse MODEL_* / AUDIO_* from the repository configuration.
# Relative paths in this file are resolved from modules/clipping/.
CLIPPER_MODEL_ENDPOINT_FILE=
CLIPPER_AUDIO_ENDPOINT_FILE=
# Or CLIPPER_MODEL_BASE_URL / NAME / API_KEY and CLIPPER_AUDIO_BASE_URL / API_KEY.
# Optional: read your Bilibili cookie from a local file, never sent to the browser.
BILIBILI_COOKIE_FILE=
# Existing AI-Tongdan credentials JSON can also be used through BILIBILI_COOKIE_JSON.
CLIPPER_PORT=6880
# ffmpeg uses CLIPPER_FFMPEG, system ffmpeg, or the imageio-ffmpeg binary.
# Optional separate network-compatible capture binary. Its child processes omit
# LD_LIBRARY_PATH/LD_PRELOAD; exports retain the main ffmpeg and its libass support.
CLIPPER_CAPTURE_FFMPEG=
CLIPPER_FFPROBE=
CLIPPER_RECORDING_GIB=30
# Colon-separated allowed roots for server-local file imports.
CLIPPER_IMPORT_ROOTS=

# Upload account is separate from live-reading credentials. File permission: 600.
# Default: data/private/bilibili-upload.cookie
BILIBILI_UPLOAD_COOKIE_FILE=
