# Optional: deploy/configure_local.py creates local endpoint and private key files.
MODEL_BASE_URL=
MODEL_NAME=Qwen3.8-27B-FP8
MODEL_API_KEY=
MODEL_TIMEOUT=90
MODEL_ENDPOINT_FILE=data/model_endpoint.json
AUDIO_ENABLED=1
AUDIO_BASE_URL=
AUDIO_API_KEY=
AUDIO_ENDPOINT_FILE=data/audio_endpoint.json
# Audio joins by original content time; adaptive observation caps this wait at 0.5s.
AUDIO_ALIGNMENT_WAIT_SECONDS=0.5
# Your own Bilibili cookie: optional for guest viewing, required for sending.
# Alternatively, bind a send-only cookie through the web page.
BILIBILI_COOKIE=
FFMPEG_BIN=ffmpeg
SAMPLE_INTERVAL=1
OBSERVATION_FRAMES=4
OBSERVATION_STRIDE=3
OBSERVATION_CONCURRENCY=2
# Adjust only inference inputs/cadence; video capture and playback stay continuous.
ADAPTIVE_OBSERVATION=1
OBSERVATION_MAX_FRAMES=8
OBSERVATION_TARGET_LAG=15
ROOM_POLL_SECONDS=20
DATA_DIR=data
# start.sh reads HOST / PORT from the shell, before .env is loaded.
# Override with: HOST=127.0.0.1 PORT=7863 ./start.sh
